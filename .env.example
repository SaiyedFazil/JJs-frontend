# ==============================================================================
# JJ's Kitchen Mobile App - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or '.env.prod' for production.
# NEVER commit sensitive production secrets directly to version control.
# ==============================================================================

# --- Application Environment ---
# Environment mode: 'development' | 'staging' | 'production'
APP_ENV=development
APP_NAME=JJ's Kitchen
APP_VERSION=1.0.0

# --- Backend API Configuration ---
# Base URL for the JJ's Kitchen REST API (include /api suffix if applicable)
# Local Android Emulator: http://10.0.2.2:3000/api
# Local Physical Device (LAN IP): http://192.168.1.X:3000/api
# Staging/Prod: https://api.jjskitchen.com/api
API_URL=http://10.0.2.2:3000/api
API_TIMEOUT=15000

# --- Real-Time Socket Connection (Order Tracking / Live Updates) ---
# WebSocket / Socket.IO server URL
SOCKET_URL=http://10.0.2.2:3000

# --- Maps & Geolocation (Address Picker & Live Delivery Tracking) ---
# Google Maps API Key for Android/iOS map rendering and places autocomplete
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Payment Gateway Integration ---
# Supported providers: RAZORPAY, STRIPE, CASH_ON_DELIVERY
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# --- Crash Reporting & Analytics ---
# Sentry DSN for crash tracking (leave empty in local dev)
SENTRY_DSN=
ENABLE_ANALYTICS=false

# --- Support & Contact ---
SUPPORT_PHONE=+919876543210
SUPPORT_EMAIL=support@jjskitchen.com
